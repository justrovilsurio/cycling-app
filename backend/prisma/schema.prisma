// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiderLevel {
  CASUAL
  MID
  RACING
}

enum TerrainType {
  ROAD
  MTB
}

enum WorkoutSource {
  MANUAL
  STRAVA
}

enum WorkoutType {
  RECOVERY
  ENDURANCE
  INTERVAL
}

enum IntensityZone {
  RECOVERY
  ENDURANCE
  TEMPO
  THRESHOLD
  VO2MAX
}

enum SpotDifficulty {
  EASY
  MODERATE
  HARD
  EXPERT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riderProfile RiderProfile?
  workouts     Workout[]
  raceGoals    RaceGoal[]
  stravaToken  StravaToken?
}

model RiderProfile {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     RiderLevel?
  weightKg  Float?
  heightCm  Float?
  age       Int?
  maxHr     Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Workout {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  type      WorkoutType
  intensity IntensityZone
  source    WorkoutSource @default(MANUAL)
  spotId    String?
  spot      Spot?         @relation(fields: [spotId], references: [id], onDelete: SetNull)

  stravaActivityId String?
  distanceMeters   Float?
  durationSeconds  Int?
  avgHeartRate     Float?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // A Strava activity is unique per user, not globally — the same athlete can
  // be connected to more than one account (and one rider can delete and
  // re-create theirs). A global unique here let one user's sync match, and
  // then overwrite, another user's workout row.
  @@unique([userId, stravaActivityId])
}

model Spot {
  id          String          @id @default(cuid())
  name        String          @unique
  terrainType TerrainType
  difficulty  SpotDifficulty?

  averageGradePercent Float?
  maxGradePercent     Float?
  distanceMeters      Float?
  elevationGainMeters Float?
  climbCategory       Int?
  suitableFor         WorkoutType[] @default([])
  notes               String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workouts    Workout[]
}

model RaceGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  raceType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StravaToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
