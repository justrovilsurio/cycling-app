PORT=3000

# Pooled connection (Supabase Supavisor) — used by the app at runtime
DATABASE_URL=
# Direct, unpooled connection — used by the Prisma CLI for migrations
DIRECT_URL=

JWT_SECRET=

# From strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your Strava API app
STRAVA_REDIRECT_URI=
